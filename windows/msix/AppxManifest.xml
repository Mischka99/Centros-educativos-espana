<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifiesto del paquete MSIX de «Centros educativos» para la Microsoft Store.
  windows/montar_msix.py rellena los valores entre llaves dobles: la identidad y el nombre los da Partner Center al
  reservar el nombre (windows/TIENDA.md), y la versión sale de la etiqueta de la versión publicada en GitHub.
  Es una aplicación de escritorio (Python y Tkinter) que necesita runFullTrust, y se conecta a internet para
  actualizar la lista y mostrar el mapa.
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">

  <Identity Name="{{NOMBRE}}" Publisher="{{EDITOR}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{NOMBRE_VISIBLE}}</DisplayName>
    <PublisherDisplayName>{{EDITOR_VISIBLE}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es-ES" />
  </Resources>

  <Applications>
    <Application Id="CentrosEducativos" Executable="CentrosEducativos.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="{{NOMBRE_VISIBLE}}"
                          Description="Centros educativos de España: teléfono y email"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
